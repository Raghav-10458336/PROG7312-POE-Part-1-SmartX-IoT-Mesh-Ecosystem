@page "/mesh"
@using System.Net.Http.Json
@using SmartX.Client.Layout
@using SmartX.Shared.Models
@inject HttpClient Http

<PageTitle>Smart-X | Mesh Network</PageTitle>

<div class="mesh-page">
    <SmartXSidebar CurrentPage="mesh" />

    <main class="mesh-main">
        <header class="mesh-header">
            <div>
                <span class="page-eyebrow">MESH NETWORK</span>
                <h1>Network Topology</h1>
                <p>Explore, analyse and manage the Smart-X wireless mesh.</p>
            </div>

            <button class="refresh-button"
                    @onclick="LoadNetwork"
                    disabled="@busy">
                @(busy ? "Refreshing..." : "Refresh network")
            </button>
        </header>

        @if (loading && topology is null)
        {
            <div class="state-panel">Loading mesh network...</div>
        }

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="state-panel error-panel">
                @errorMessage
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="state-panel mesh-success">
                @successMessage
            </div>
        }

        @if (topology is not null)
        {
            <section class="summary-grid">
                <div class="summary-card">
                    <span>Total nodes</span>
                    <strong>@topology.Nodes.Count</strong>
                    <small>Gateway and sensors</small>
                </div>

                <div class="summary-card">
                    <span>Online sensors</span>
                    <strong>
                        @topology.Nodes.Count(n =>
                            n.Type == MeshNodeType.Sensor && n.IsOnline)
                    </strong>
                    <small>Currently active devices</small>
                </div>

                <div class="summary-card">
                    <span>Wireless links</span>
                    <strong>@topology.Links.Count</strong>
                    <small>
                        @topology.Links.Count(l => l.IsEnabled) enabled
                    </small>
                </div>

                <div class="summary-card">
                    <span>Gateway</span>
                    <strong class="gateway-value">
                        @(GatewayNode?.IsOnline == true
                            ? "Online" : "Offline")
                    </strong>
                    <small>@topology.GatewayId</small>
                </div>
            </section>

            <section class="mesh-content">
                <div class="topology-panel">
                    <div class="panel-heading">
                        <div>
                            <span class="panel-eyebrow">
                                NETWORK VISUALISATION
                            </span>
                            <h2>Wireless mesh map</h2>
                        </div>

                        <span class="panel-note">
                            Select a node to inspect
                        </span>
                    </div>

                    <div class="mesh-toolbar">
                        <span class="mesh-toolbar-label">
                            Display mode
                        </span>

                        <button class="mesh-mode-button @(displayMode == "topology" ? "active" : "")"
                                @onclick='() => SetDisplayMode("topology")'>
                            Full topology
                        </button>

                        <button class="mesh-mode-button @(displayMode == "bfs" ? "active" : "")"
                                @onclick='() => SetDisplayMode("bfs")'>
                            BFS connectivity
                        </button>

                        <button class="mesh-mode-button @(displayMode == "mst" ? "active" : "")"
                                @onclick='() => SetDisplayMode("mst")'>
                            Prim's MST
                        </button>

                        <button class="mesh-mode-button @(displayMode == "route" ? "active" : "")"
                                disabled="@(ActiveRoute is null)"
                                @onclick='() => SetDisplayMode("route")'>
                            Selected route
                        </button>
                    </div>

                    <!-- Quick route controls beside the visualisation -->
                    <div class="mesh-quick-route">
                        <div class="mesh-quick-heading">
                            <div>
                                <strong>Quick route comparison</strong>
                                <span>
                                    Select a sensor and compare both algorithms.
                                </span>
                            </div>

                            @if (displayMode == "route" &&
                                 ActiveRoute is not null)
                            {
                                <span class="mesh-active-label">
                                    @(routeType == "shortest"
                                        ? "Dijkstra active"
                                        : "MST route active")
                                </span>
                            }
                        </div>

                        <div class="mesh-quick-controls">
                            <div class="mesh-quick-select">
                                <label for="mesh-quick-sensor">
                                    Sensor
                                </label>

                                <select id="mesh-quick-sensor"
                                        class="mesh-select"
                                        value="@routeSensorId"
                                        @onchange="OnRouteSensorChanged">
                                    <option value="">
                                        Choose a sensor
                                    </option>

                                    @foreach (var sensor in topology.Nodes
                                        .Where(n =>
                                            n.Type == MeshNodeType.Sensor)
                                        .OrderBy(n => n.Label))
                                    {
                                        <option value="@sensor.Id">
                                            @sensor.Label (@sensor.Id)
                                        </option>
                                    }
                                </select>
                            </div>

                            <button class="mesh-action-button"
                                    disabled="@(busy || string.IsNullOrWhiteSpace(routeSensorId))"
                                    @onclick="LoadRoutes">
                                @(busy ? "Please wait..." : "Compare routes")
                            </button>

                            <button class="mesh-secondary-action"
                                    @onclick="ClearRoutes">
                                Clear
                            </button>
                        </div>

                        @if (shortestRoute is not null &&
                             mstRoute is not null)
                        {
                            <div class="mesh-route-switcher">
                                <button class="mesh-route-toggle @(displayMode == "route" && routeType == "shortest" ? "active" : "")"
                                        @onclick='() => ShowRoute("shortest")'>
                                    Dijkstra shortest path
                                </button>

                                <button class="mesh-route-toggle @(displayMode == "route" && routeType == "mst" ? "active" : "")"
                                        @onclick='() => ShowRoute("mst")'>
                                    MST route
                                </button>
                            </div>

                            @if (displayMode == "route" &&
                                 ActiveRoute is not null)
                            {
                                <div class="mesh-quick-result">
                                    <div class="mesh-quick-metrics">
                                        <span>
                                            <strong>
                                                @(routeType == "shortest"
                                                    ? "Dijkstra"
                                                    : "MST route")
                                            </strong>
                                        </span>

                                        <span>
                                            @ActiveRoute.HopCount hops
                                        </span>

                                        <span>
                                            Weight
                                            @ActiveRoute.TotalWeight.ToString("0.##")
                                        </span>

                                        <span class="@(ActiveRoute.IsReachable ? "mesh-reachable" : "mesh-not-reachable")">
                                            @(ActiveRoute.IsReachable
                                                ? "Reachable"
                                                : "Unreachable")
                                        </span>
                                    </div>

                                    @if (ActiveRoute.IsReachable)
                                    {
                                        <div class="mesh-quick-path">
                                            @string.Join(" → ", ActiveRoute.Path)
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="mesh-quick-path">
                                            No available route to the gateway.
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </div>

                    <div class="network-canvas">
                        <svg viewBox="-5 -5 110 110"
                             preserveAspectRatio="xMidYMid meet"
                             role="img"
                             aria-label="Smart-X wireless mesh topology">

                            @foreach (var link in topology.Links)
                            {
                                var source = FindNode(link.SourceId);
                                var target = FindNode(link.TargetId);

                                if (source is not null &&
                                    target is not null)
                                {
                                    var healthy =
                                        link.IsEnabled &&
                                        source.IsOnline &&
                                        target.IsOnline;

                                    var highlighted =
                                        IsHighlightedLink(link);

                                    var linkClass = "mesh-link";

                                    if (!healthy)
                                    {
                                        linkClass += " disabled";
                                    }

                                    if (displayMode != "topology")
                                    {
                                        linkClass += highlighted
                                            ? " mesh-highlight"
                                            : " mesh-muted";
                                    }

                                    <line x1="@source.X"
                                          y1="@source.Y"
                                          x2="@target.X"
                                          y2="@target.Y"
                                          class="@linkClass" />
                                }
                            }

                            @foreach (var node in topology.Nodes)
                            {
                                var selected = string.Equals(
                                    selectedNodeId,
                                    node.Id,
                                    StringComparison.OrdinalIgnoreCase);

                                var nodeClass = "mesh-node";

                                if (selected)
                                {
                                    nodeClass += " selected";
                                }

                                if (displayMode == "bfs" &&
                                    connectivity is not null &&
                                    !IsReachable(node.Id))
                                {
                                    nodeClass += " mesh-unreachable";
                                }

                                if (displayMode == "route" &&
                                    ActiveRoute is not null &&
                                    !ActiveRoute.Path.Contains(
                                        node.Id,
                                        StringComparer.OrdinalIgnoreCase))
                                {
                                    nodeClass += " mesh-route-muted";
                                }

                                <g class="@nodeClass"
                                   @onclick="() => SelectNode(node.Id)">

                                    <circle cx="@node.X"
                                            cy="@node.Y"
                                            r="@(node.Type == MeshNodeType.Gateway ? 3.4 : 2.3)"
                                            class="@(node.Type == MeshNodeType.Gateway
                                                                                    ? "gateway-node"
                                                                                    : node.IsOnline
                                                                                        ? "online-node"
                                                                                        : "offline-node")" />

                                    @if (node.Type == MeshNodeType.Gateway)
                                    {
                                        <svg:text x="@node.X"
                                                  y="@(node.Y - 5)"
                                                  class="node-label gateway-label"
                                                  text-anchor="middle">
                                            Gateway
                                        </svg:text>
                                    }
                                    else
                                    {
                                        <title>
                                            @($"{node.Label} ({node.Id})")
                                        </title>
                                    }
                                </g>
                            }
                        </svg>
                    </div>

                    <div class="legend">
                        <span>
                            <i class="legend-dot gateway-dot"></i>
                            Gateway
                        </span>

                        <span>
                            <i class="legend-dot online-dot"></i>
                            Online sensor
                        </span>

                        <span>
                            <i class="legend-dot offline-dot"></i>
                            Offline sensor
                        </span>

                        <span>
                            <i class="legend-line"></i>
                            Enabled link
                        </span>

                        <span>
                            <i class="legend-line disabled-line"></i>
                            Disabled link
                        </span>

                        <span>
                            <i class="legend-line highlight-line"></i>
                            Highlighted path
                        </span>
                    </div>
                </div>

                <aside class="details-panel">
                    <span class="panel-eyebrow">
                        DEVICE INSPECTOR
                    </span>

                    <h2>Node details</h2>

                    @if (SelectedNode is null)
                    {
                        <p class="hint">
                            Select a gateway or sensor on the map
                            to view its details and controls.
                        </p>
                    }
                    else
                    {
                        <div class="node-details">
                            <span class="status-pill @(SelectedNode.IsOnline ? "status-online" : "status-offline")">
                                @(SelectedNode.IsOnline
                                    ? "Online"
                                    : "Offline")
                            </span>

                            <h3>@SelectedNode.Label</h3>

                            <dl>
                                <dt>Identifier</dt>
                                <dd>@SelectedNode.Id</dd>

                                <dt>Type</dt>
                                <dd>@SelectedNode.Type</dd>

                                <dt>Deployment</dt>
                                <dd>@SelectedNode.DeploymentLocation</dd>

                                <dt>Connected links</dt>
                                <dd>
                                    @ConnectedLinkCount(SelectedNode.Id)
                                </dd>

                                @if (connectivity is not null)
                                {
                                    <dt>BFS connectivity</dt>
                                    <dd>
                                        @(IsReachable(SelectedNode.Id)
                                            ? "Reachable"
                                            : "Unreachable")
                                    </dd>

                                    @if (connectivity.HopCounts.TryGetValue(
                                        SelectedNode.Id,
                                        out var hops))
                                    {
                                        <dt>Gateway hop count</dt>
                                        <dd>@hops</dd>
                                    }
                                }
                            </dl>

                            <div class="mesh-control-section">
                                <strong>Node status control</strong>

                                <p>
                                    Simulate a device failure or recovery.
                                </p>

                                <button class="mesh-action-button"
                                        disabled="@busy"
                                        @onclick="() => ToggleNode(SelectedNode.Id, !SelectedNode.IsOnline)">
                                    @(SelectedNode.IsOnline
                                        ? "Take node offline"
                                        : "Bring node online")
                                </button>
                            </div>
                        </div>
                    }

                    @if (displayMode == "route" &&
                         ActiveRoute is not null)
                    {
                        <div class="mesh-inspector-route">
                            <span class="panel-eyebrow">
                                ACTIVE ROUTE
                            </span>

                            <h3>
                                @(routeType == "shortest"
                                    ? "Dijkstra shortest path"
                                    : "Minimum spanning tree route")
                            </h3>

                            <div class="mesh-inspector-metrics">
                                <div>
                                    <strong>@ActiveRoute.HopCount</strong>
                                    <span>Hops</span>
                                </div>

                                <div>
                                    <strong>
                                        @ActiveRoute.TotalWeight.ToString("0.##")
                                    </strong>
                                    <span>Weight</span>
                                </div>
                            </div>

                            <p>
                                @(ActiveRoute.IsReachable
                                    ? string.Join(" → ", ActiveRoute.Path)
                                    : "No available path to the gateway.")
                            </p>
                        </div>
                    }

                    <div class="inspector-footer">
                        <strong>Network snapshot</strong>

                        <span>
                            @(topology.GeneratedAtUtc.ToLocalTime()
                                .ToString("dd MMM yyyy, HH:mm:ss"))
                        </span>
                    </div>
                </aside>
            </section>

            <section class="mesh-analysis-grid">
                <div class="mesh-analysis-card">
                    <span class="panel-eyebrow">
                        BREADTH-FIRST SEARCH
                    </span>

                    <h2>BFS connectivity</h2>

                    <p>
                        Discover which sensors can communicate
                        with the gateway.
                    </p>

                    @if (connectivity is not null)
                    {
                        <div class="mesh-stat-row">
                            <div>
                                <strong>@ReachableSensorCount</strong>
                                <span>Reachable sensors</span>
                            </div>

                            <div>
                                <strong>
                                    @connectivity.UnreachableNodeIds.Count
                                </strong>
                                <span>Unreachable sensors</span>
                            </div>
                        </div>

                        <div class="mesh-result">
                            <strong>Gateway reachability</strong>

                            <span>
                                @ReachableSensorCount of
                                @topology.Nodes.Count(n =>
                                    n.Type == MeshNodeType.Sensor)
                                sensors reachable
                            </span>
                        </div>

                        @if (connectivity.UnreachableNodeIds.Count > 0)
                        {
                            <div class="mesh-result">
                                <strong>Disconnected sensors</strong>

                                <span>
                                    @string.Join(
                                        ", ",
                                        connectivity.UnreachableNodeIds)
                                </span>
                            </div>
                        }

                        <button class="mesh-action-button"
                                @onclick='() => SetDisplayMode("bfs")'>
                            Show BFS on map
                        </button>
                    }
                </div>

                <div class="mesh-analysis-card">
                    <span class="panel-eyebrow">
                        PRIM'S ALGORITHM
                    </span>

                    <h2>Minimum spanning tree</h2>

                    <p>
                        Find the gateway-connected tree
                        with minimum total link weight.
                    </p>

                    @if (mst is not null)
                    {
                        <div class="mesh-stat-row">
                            <div>
                                <strong>@mst.SelectedLinks.Count</strong>
                                <span>Selected links</span>
                            </div>

                            <div>
                                <strong>
                                    @mst.TotalWeight.ToString("0.##")
                                </strong>
                                <span>Total weight</span>
                            </div>
                        </div>

                        <div class="mesh-result">
                            <strong>Online network coverage</strong>

                            <span>
                                @(mst.SpansAllOnlineNodes
                                    ? "All online nodes are connected"
                                    : "Some online nodes are disconnected")
                            </span>
                        </div>

                        <button class="mesh-action-button"
                                @onclick='() => SetDisplayMode("mst")'>
                            Highlight MST
                        </button>
                    }
                </div>

                <div class="mesh-analysis-card">
                    <span class="panel-eyebrow">
                        DIJKSTRA &amp; MST ROUTING
                    </span>

                    <h2>Route comparison</h2>

                    <p>
                        Compare the shortest weighted route
                        with the MST route.
                    </p>

                    <label class="mesh-field-label"
                           for="mesh-sensor">
                        Select sensor
                    </label>

                    <select id="mesh-sensor"
                            class="mesh-select"
                            value="@routeSensorId"
                            @onchange="OnRouteSensorChanged">

                        <option value="">
                            Choose a sensor
                        </option>

                        @foreach (var sensor in topology.Nodes
                            .Where(n => n.Type == MeshNodeType.Sensor)
                            .OrderBy(n => n.Label))
                        {
                            <option value="@sensor.Id">
                                @sensor.Label (@sensor.Id)
                            </option>
                        }
                    </select>

                    <div class="mesh-route-actions">
                        <button class="mesh-action-button"
                                disabled="@(busy || string.IsNullOrWhiteSpace(routeSensorId))"
                                @onclick="LoadRoutes">
                            @(busy
                                ? "Please wait..."
                                : "Compare routes")
                        </button>

                        <button class="mesh-secondary-action"
                                @onclick="ClearRoutes">
                            Clear
                        </button>
                    </div>

                    @if (shortestRoute is not null &&
                         mstRoute is not null)
                    {
                        <div class="mesh-route-result">
                            <strong>Dijkstra shortest path</strong>

                            @if (shortestRoute.IsReachable)
                            {
                                <span>
                                    @string.Join(
                                        " → ",
                                        shortestRoute.Path)
                                </span>

                                <small>
                                    @shortestRoute.HopCount hops ·
                                    Weight
                                    @shortestRoute.TotalWeight.ToString("0.##")
                                </small>
                            }
                            else
                            {
                                <span>Sensor is unreachable.</span>
                            }
                        </div>

                        <div class="mesh-route-result">
                            <strong>MST route</strong>

                            @if (mstRoute.IsReachable)
                            {
                                <span>
                                    @string.Join(
                                        " → ",
                                        mstRoute.Path)
                                </span>

                                <small>
                                    @mstRoute.HopCount hops ·
                                    Weight
                                    @mstRoute.TotalWeight.ToString("0.##")
                                </small>
                            }
                            else
                            {
                                <span>
                                    Sensor is unreachable through the MST.
                                </span>
                            }
                        </div>

                        <div class="mesh-route-actions">
                            <button class="mesh-route-toggle @(displayMode == "route" && routeType == "shortest" ? "active" : "")"
                                    @onclick='() => ShowRoute("shortest")'>
                                Show Dijkstra
                            </button>

                            <button class="mesh-route-toggle @(displayMode == "route" && routeType == "mst" ? "active" : "")"
                                    @onclick='() => ShowRoute("mst")'>
                                Show MST route
                            </button>
                        </div>
                    }
                </div>

                <div class="mesh-analysis-card">
                    <span class="panel-eyebrow">
                        NETWORK SIMULATION
                    </span>

                    <h2>Wireless link controls</h2>

                    <p>
                        Disable or restore connections
                        to test network resilience.
                    </p>

                    <label class="mesh-field-label"
                           for="mesh-link">
                        Select wireless link
                    </label>

                    <select id="mesh-link"
                            class="mesh-select"
                            value="@selectedLinkKey"
                            @onchange="OnLinkChanged">

                        <option value="">
                            Choose a connection
                        </option>

                        @for (var i = 0; i < topology.Links.Count; i++)
                        {
                            var link = topology.Links[i];

                            <option value="@i">
                                @link.SourceId ↔ @link.TargetId
                            </option>
                        }
                    </select>

                    @if (SelectedLink is not null)
                    {
                        <div class="mesh-result">
                            <strong>Link weight</strong>

                            <span>
                                @SelectedLink.Weight.ToString("0.##")
                            </span>
                        </div>

                        <div class="mesh-result">
                            <strong>Connection status</strong>

                            <span>
                                @(SelectedLink.IsEnabled
                                    ? "Enabled"
                                    : "Disabled")
                            </span>
                        </div>

                        <button class="mesh-action-button"
                                disabled="@busy"
                                @onclick="ToggleSelectedLink">
                            @(SelectedLink.IsEnabled
                                ? "Disable connection"
                                : "Enable connection")
                        </button>
                    }
                </div>
            </section>
        }
    </main>
</div>

@code {
    private MeshNetworkSnapshot? topology;
    private MeshConnectivityResult? connectivity;
    private MeshMstResult? mst;
    private MeshRouteResult? shortestRoute;
    private MeshRouteResult? mstRoute;

    private string? selectedNodeId;
    private string? errorMessage;
    private string? successMessage;

    private string displayMode = "topology";
    private string routeType = "shortest";
    private string routeSensorId = "";
    private string selectedLinkKey = "";

    private bool loading = true;
    private bool busy;

    private MeshNode? SelectedNode =>
        selectedNodeId is null
            ? null
            : FindNode(selectedNodeId);

    private MeshNode? GatewayNode =>
        topology is null
            ? null
            : FindNode(topology.GatewayId);

    private MeshLink? SelectedLink =>
        topology is not null &&
        int.TryParse(selectedLinkKey, out var index) &&
        index >= 0 &&
        index < topology.Links.Count
            ? topology.Links[index]
            : null;

    private MeshRouteResult? ActiveRoute =>
        routeType == "mst"
            ? mstRoute
            : shortestRoute;

    private int ReachableSensorCount =>
        connectivity is null || topology is null
            ? 0
            : topology.Nodes.Count(node =>
                node.Type == MeshNodeType.Sensor &&
                connectivity.ReachableNodeIds.Contains(
                    node.Id,
                    StringComparer.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await LoadNetwork();
    }

    private MeshNode? FindNode(string id)
    {
        return topology?.Nodes.FirstOrDefault(node =>
            string.Equals(
                node.Id,
                id,
                StringComparison.OrdinalIgnoreCase));
    }

    private int ConnectedLinkCount(string nodeId)
    {
        return topology?.Links.Count(link =>
            string.Equals(
                link.SourceId,
                nodeId,
                StringComparison.OrdinalIgnoreCase) ||
            string.Equals(
                link.TargetId,
                nodeId,
                StringComparison.OrdinalIgnoreCase)) ?? 0;
    }

    private bool IsReachable(string nodeId)
    {
        return connectivity?.ReachableNodeIds.Contains(
            nodeId,
            StringComparer.OrdinalIgnoreCase) == true;
    }

    private void SelectNode(string id)
    {
        selectedNodeId = id;

        var node = FindNode(id);

        if (node?.Type == MeshNodeType.Sensor)
        {
            routeSensorId = node.Id;
            ClearRouteResults();
        }
    }

    private void SetDisplayMode(string mode)
    {
        if (mode == "route" && ActiveRoute is null)
        {
            return;
        }

        displayMode = mode;
    }

    private void ShowRoute(string type)
    {
        routeType = type;
        displayMode = "route";
    }

    private void OnRouteSensorChanged(ChangeEventArgs args)
    {
        routeSensorId = args.Value?.ToString() ?? "";
        ClearRouteResults();
    }

    private void OnLinkChanged(ChangeEventArgs args)
    {
        selectedLinkKey = args.Value?.ToString() ?? "";
    }

    private void ClearRouteResults()
    {
        shortestRoute = null;
        mstRoute = null;

        if (displayMode == "route")
        {
            displayMode = "topology";
        }
    }

    private void ClearRoutes()
    {
        routeSensorId = "";
        ClearRouteResults();
    }

    private bool SameLink(MeshLink first, MeshLink second)
    {
        return
            (string.Equals(
                first.SourceId,
                second.SourceId,
                StringComparison.OrdinalIgnoreCase) &&
             string.Equals(
                first.TargetId,
                second.TargetId,
                StringComparison.OrdinalIgnoreCase)) ||
            (string.Equals(
                first.SourceId,
                second.TargetId,
                StringComparison.OrdinalIgnoreCase) &&
             string.Equals(
                first.TargetId,
                second.SourceId,
                StringComparison.OrdinalIgnoreCase));
    }

    private bool IsHighlightedLink(MeshLink link)
    {
        if (displayMode == "topology")
        {
            return false;
        }

        if (displayMode == "mst")
        {
            return mst?.SelectedLinks.Any(selected =>
                SameLink(link, selected)) == true;
        }

        if (displayMode == "bfs")
        {
            if (connectivity is null)
            {
                return false;
            }

            return connectivity.Parents.Any(parent =>
                parent.Value is not null &&
                ((string.Equals(
                    parent.Key,
                    link.SourceId,
                    StringComparison.OrdinalIgnoreCase) &&
                  string.Equals(
                    parent.Value,
                    link.TargetId,
                    StringComparison.OrdinalIgnoreCase)) ||
                 (string.Equals(
                    parent.Key,
                    link.TargetId,
                    StringComparison.OrdinalIgnoreCase) &&
                  string.Equals(
                    parent.Value,
                    link.SourceId,
                    StringComparison.OrdinalIgnoreCase))));
        }

        if (displayMode == "route" &&
            ActiveRoute?.IsReachable == true)
        {
            for (var i = 0;
                 i < ActiveRoute.Path.Count - 1;
                 i++)
            {
                var from = ActiveRoute.Path[i];
                var to = ActiveRoute.Path[i + 1];

                if ((string.Equals(
                        link.SourceId,
                        from,
                        StringComparison.OrdinalIgnoreCase) &&
                     string.Equals(
                        link.TargetId,
                        to,
                        StringComparison.OrdinalIgnoreCase)) ||
                    (string.Equals(
                        link.SourceId,
                        to,
                        StringComparison.OrdinalIgnoreCase) &&
                     string.Equals(
                        link.TargetId,
                        from,
                        StringComparison.OrdinalIgnoreCase)))
                {
                    return true;
                }
            }
        }

        return false;
    }

    private async Task LoadNetwork()
    {
        loading = true;
        busy = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var newTopology =
                await Http.GetFromJsonAsync<MeshNetworkSnapshot>(
                    "api/mesh/topology");

            var newConnectivity =
                await Http.GetFromJsonAsync<MeshConnectivityResult>(
                    "api/mesh/connectivity");

            var newMst =
                await Http.GetFromJsonAsync<MeshMstResult>(
                    "api/mesh/mst");

            if (newTopology is null ||
                newConnectivity is null ||
                newMst is null)
            {
                throw new InvalidOperationException(
                    "The mesh API returned incomplete network data.");
            }

            topology = newTopology;
            connectivity = newConnectivity;
            mst = newMst;

            if (selectedNodeId is not null &&
                FindNode(selectedNodeId) is null)
            {
                selectedNodeId = null;
            }

            if (!string.IsNullOrWhiteSpace(routeSensorId) &&
                FindNode(routeSensorId) is null)
            {
                routeSensorId = "";
            }

            selectedLinkKey = "";
            ClearRouteResults();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to load the mesh network: {ex.Message}";
        }
        finally
        {
            loading = false;
            busy = false;
        }
    }

    private async Task LoadRoutes()
    {
        if (busy ||
            string.IsNullOrWhiteSpace(routeSensorId))
        {
            return;
        }

        busy = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var id = Uri.EscapeDataString(routeSensorId);

            var shortest =
                await Http.GetFromJsonAsync<MeshRouteResult>(
                    $"api/mesh/routes/{id}/shortest");

            var treeRoute =
                await Http.GetFromJsonAsync<MeshRouteResult>(
                    $"api/mesh/routes/{id}");

            if (shortest is null || treeRoute is null)
            {
                throw new InvalidOperationException(
                    "The route API returned incomplete data.");
            }

            shortestRoute = shortest;
            mstRoute = treeRoute;

            routeType = "shortest";
            displayMode = "route";
        }
        catch (Exception ex)
        {
            ClearRouteResults();

            errorMessage =
                $"Unable to calculate routes: {ex.Message}";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ToggleNode(
        string nodeId,
        bool isOnline)
    {
        if (busy)
        {
            return;
        }

        busy = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var id = Uri.EscapeDataString(nodeId);

            using var response =
                await Http.PutAsJsonAsync(
                    $"api/mesh/nodes/{id}/status",
                    new { IsOnline = isOnline });

            response.EnsureSuccessStatusCode();

            await LoadNetwork();

            successMessage =
                $"Node {nodeId} is now " +
                $"{(isOnline ? "online" : "offline")}.";
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to update node status: {ex.Message}";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ToggleSelectedLink()
    {
        if (busy || SelectedLink is null)
        {
            return;
        }

        var link = SelectedLink;
        var enabled = !link.IsEnabled;

        busy = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            using var response =
                await Http.PutAsJsonAsync(
                    "api/mesh/links/status",
                    new
                    {
                        link.SourceId,
                        link.TargetId,
                        IsEnabled = enabled
                    });

            response.EnsureSuccessStatusCode();

            await LoadNetwork();

            successMessage = enabled
                ? "Wireless connection enabled successfully."
                : "Wireless connection disabled successfully.";
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to update wireless link: {ex.Message}";
        }
        finally
        {
            busy = false;
        }
    }
}
