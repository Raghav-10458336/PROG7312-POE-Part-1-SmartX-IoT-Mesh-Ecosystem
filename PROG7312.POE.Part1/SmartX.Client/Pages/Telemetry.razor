@page "/telemetry"

@using System.Net.Http.Json
@using SmartX.Shared.Enums
@using SmartX.Shared.Models
@using SmartX.Shared.Telemetry

@inject HttpClient Http

<PageTitle>Smart-X | Telemetry</PageTitle>

<div class="telemetry-page">

    <aside class="sidebar">
        <a class="sidebar-brand" href="/">
            <div class="brand-mark">SX</div>

            <div>
                <strong>Smart-X</strong>
                <span>IoT Mesh</span>
            </div>
        </a>

        <nav class="sidebar-nav">
            <span class="nav-label">WORKSPACE</span>

            <a class="nav-item" href="/dashboard">
                <span class="nav-icon">⌂</span>
                Dashboard
            </a>

            <a class="nav-item" href="/sensors">
                <span class="nav-icon">◉</span>
                Sensors
            </a>

            <a class="nav-item active" href="/telemetry">
                <span class="nav-icon">⌁</span>
                Telemetry
            </a>

            <a class="nav-item" href="/alerts">
                <span class="nav-icon">!</span>
                Attention Centre
            </a>

            <span class="nav-label secondary-label">
                MANAGEMENT
            </span>

            <a class="nav-item" href="/attachments">
                <span class="nav-icon">□</span>
                Attachments
            </a>

            <a class="nav-item" href="/deployment">
                <span class="nav-icon">⌘</span>
                Deployment Validation
            </a>
        </nav>

        <div class="sidebar-footer">
            <span class="sidebar-status">
                <span class="status-dot"></span>
                Gateway connected
            </span>

            <span>Part 1 Gateway</span>
        </div>
    </aside>

    <main class="main-content">

        <header class="page-header">
            <div>
                <span class="page-eyebrow">
                    TELEMETRY INGESTION
                </span>

                <h1>Telemetry Stream</h1>

                <p>
                    Submit and inspect environmental, power and actuator
                    readings processed by the Smart-X gateway.
                </p>
            </div>

            <a class="back-button" href="/dashboard">
                ← Dashboard
            </a>
        </header>

        @if (loading)
        {
            <div class="loading-panel">
                Loading telemetry from the Smart-X gateway...
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="error-panel">
                <strong>Telemetry unavailable</strong>
                <span>@errorMessage</span>
            </div>
        }
        else
        {
            <section class="summary-grid">

                <div class="summary-card">
                    <span>Total packets</span>
                    <strong>@allTelemetry.Count.ToString("N0")</strong>
                    <small>Current gateway workload</small>
                </div>

                <div class="summary-card environmental-card">
                    <span>Environmental</span>
                    <strong>@floatCount.ToString("N0")</strong>
                    <small>Float telemetry packets</small>
                </div>

                <div class="summary-card power-card">
                    <span>Power</span>
                    <strong>@integerCount.ToString("N0")</strong>
                    <small>Integer telemetry packets</small>
                </div>

                <div class="summary-card actuator-card">
                    <span>Actuator</span>
                    <strong>@booleanCount.ToString("N0")</strong>
                    <small>Boolean telemetry packets</small>
                </div>

            </section>

            <section class="ingestion-panel">

                <div class="panel-heading">

                    <div>
                        <span class="panel-eyebrow">
                            API RECEIVER
                        </span>

                        <h2>Submit sensor reading</h2>

                        <p>
                            Push a typed telemetry packet to the Smart-X
                            API and verify immediate backend ingestion.
                        </p>
                    </div>

                    <div class="receiver-status">
                        <span class="receiver-dot"></span>

                        <div>
                            <strong>Online</strong>
                            <small>Telemetry receiver</small>
                        </div>
                    </div>

                </div>

                <div class="ingestion-form">

                    <div class="form-field">
                        <label>Telemetry type</label>

                        <select value="@submissionType"
                                @onchange="SubmissionTypeChanged">

                            <option value="Float">
                                Environmental / Float
                            </option>

                            <option value="Integer">
                                Power / Integer
                            </option>

                            <option value="Boolean">
                                Actuator / Boolean
                            </option>

                        </select>
                    </div>

                    <div class="form-field sensor-field">
                        <label>Sensor</label>

                        <select @bind="submissionSensorId">

                            <option value="">
                                Select registered sensor
                            </option>

                            @foreach (SensorRegistration sensor
                                in EligibleSubmissionSensors)
                            {
                                <option value="@sensor.Id">
                                    @sensor.DeviceIdentifier —
                                    @sensor.DeploymentLocation
                                </option>
                            }

                        </select>
                    </div>

                    <div class="form-field">
                        <label>Metric</label>

                        <select value="@submissionMetric"
                                @onchange="SubmissionMetricChanged">

                            @foreach (string metric
                                in AvailableSubmissionMetrics)
                            {
                                <option value="@metric">
                                    @metric
                                </option>
                            }

                        </select>
                    </div>

                    <div class="form-field unit-field">
                        <label>Unit</label>

                        <input type="text"
                               @bind="submissionUnit" />
                    </div>

                    @if (submissionType == "Boolean")
                    {
                        <div class="form-field">
                            <label>Value</label>

                            <select @bind="submissionBooleanValue">
                                <option value="true">
                                    True
                                </option>

                                <option value="false">
                                    False
                                </option>
                            </select>
                        </div>
                    }
                    else
                    {
                        <div class="form-field">
                            <label>Value</label>

                            <input type="number"
                                   step="any"
                                   @bind="submissionNumericValue"
                                   placeholder="Enter reading" />
                        </div>
                    }

                    <div class="form-action">
                        <button class="submit-reading-button"
                                disabled="@submittingReading"
                                @onclick="SubmitTelemetry">

                            @if (submittingReading)
                            {
                                <span>Submitting...</span>
                            }
                            else
                            {
                                <span>Submit reading</span>
                            }

                        </button>
                    </div>

                </div>

                @if (!string.IsNullOrWhiteSpace(submissionSuccess))
                {
                    <div class="submission-success">
                        <strong>Reading accepted</strong>
                        <span>@submissionSuccess</span>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(submissionError))
                {
                    <div class="submission-error">
                        <strong>Unable to submit reading</strong>
                        <span>@submissionError</span>
                    </div>
                }

            </section>

            <section class="telemetry-panel">

                <div class="panel-heading">
                    <div>
                        <span class="panel-eyebrow">
                            RECEIVED DATA
                        </span>

                        <h2>Telemetry readings</h2>

                        <p>
                            Filter the current gateway workload by device,
                            metric or telemetry type.
                        </p>
                    </div>

                    <div class="result-count">
                        @FilteredTelemetry.Count().ToString("N0")
                        <span>matching</span>
                    </div>
                </div>

                <div class="filter-bar">

                    <div class="search-field">
                        <label>Search</label>

                        <input type="text"
                               placeholder="Device or metric..."
                               @bind="searchText"
                               @bind:event="oninput" />
                    </div>

                    <div class="filter-field">
                        <label>Telemetry type</label>

                        <select @bind="selectedType">
                            <option value="All">
                                All types
                            </option>

                            <option value="Environmental">
                                Environmental
                            </option>

                            <option value="Power">
                                Power
                            </option>

                            <option value="Actuator">
                                Actuator
                            </option>
                        </select>
                    </div>

                    <div class="filter-field">
                        <label>Metric</label>

                        <select @bind="selectedMetric">
                            <option value="All">
                                All metrics
                            </option>

                            @foreach (string metric in metricNames)
                            {
                                <option value="@metric">
                                    @metric
                                </option>
                            }
                        </select>
                    </div>

                    <button class="clear-button"
                            @onclick="ClearFilters">
                        Clear filters
                    </button>

                </div>

                <div class="table-note">
                    Showing the latest
                    <strong>100</strong>
                    matching readings to keep the dashboard responsive.
                </div>

                @if (!FilteredTelemetry.Any())
                {
                    <div class="empty-state">
                        No telemetry readings match the selected filters.
                    </div>
                }
                else
                {
                    <div class="table-wrapper">

                        <table class="telemetry-table">

                            <thead>
                                <tr>
                                    <th>Device</th>
                                    <th>Type</th>
                                    <th>Metric</th>
                                    <th>Value</th>
                                    <th>Received</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (TelemetryDisplayRow row
                                    in FilteredTelemetry.Take(100))
                                {
                                    <tr>

                                        <td>
                                            <div class="device-cell">

                                                <div class="device-indicator @GetTypeClass(row.TelemetryType)">
                                                    @GetTypeLetter(row.TelemetryType)
                                                </div>

                                                <div>
                                                    <strong>
                                                        @row.DeviceIdentifier
                                                    </strong>

                                                    <span>
                                                        @row.SensorId.ToString()[..8]
                                                    </span>
                                                </div>

                                            </div>
                                        </td>

                                        <td>
                                            <span class="type-badge @GetTypeClass(row.TelemetryType)">
                                                @row.TelemetryType
                                            </span>
                                        </td>

                                        <td>
                                            <strong class="metric-name">
                                                @row.MetricName
                                            </strong>
                                        </td>

                                        <td>
                                            <span class="reading-value">
                                                @row.DisplayValue
                                            </span>
                                        </td>

                                        <td>
                                            <div class="timestamp-cell">
                                                <strong>
                                                    @(row.TimestampUtc
                                                        .ToLocalTime()
                                                        .ToString("HH:mm:ss"))
                                                </strong>

                                                <span>
                                                    @(row.TimestampUtc
                                                        .ToLocalTime()
                                                        .ToString("dd MMM yyyy"))
                                                </span>
                                            </div>
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </section>
        }

    </main>
</div>

@code {
    private bool loading = true;

    private string? errorMessage;

    private string searchText = string.Empty;
    private string selectedType = "All";
    private string selectedMetric = "All";

    private int floatCount;
    private int integerCount;
    private int booleanCount;

    private List<TelemetryDisplayRow> allTelemetry = new();
    private List<string> metricNames = new();
    private List<SensorRegistration> sensors = new();

    private string submissionSensorId = string.Empty;

    private string submissionType = "Float";

    private string submissionMetric = "Soil Moisture";

    private string submissionUnit = "%";

    private double? submissionNumericValue;

    private string submissionBooleanValue = "true";

    private bool submittingReading;

    private string? submissionSuccess;
    private string? submissionError;

    protected override async Task OnInitializedAsync()
    {
        await LoadTelemetry();
    }

    private async Task LoadTelemetry(
        bool showLoadingPanel = true)
    {
        if (showLoadingPanel)
        {
            loading = true;
        }

        errorMessage = null;

        try
        {
            Task<List<SensorRegistration>?> sensorTask =
                Http.GetFromJsonAsync<List<SensorRegistration>>(
                    "api/sensors");

            Task<List<TelemetryPacket<float>>?> floatTask =
                Http.GetFromJsonAsync<List<TelemetryPacket<float>>>(
                    "api/telemetry/float");

            Task<List<TelemetryPacket<int>>?> integerTask =
                Http.GetFromJsonAsync<List<TelemetryPacket<int>>>(
                    "api/telemetry/integer");

            Task<List<TelemetryPacket<bool>>?> booleanTask =
                Http.GetFromJsonAsync<List<TelemetryPacket<bool>>>(
                    "api/telemetry/boolean");

            await Task.WhenAll(
                sensorTask,
                floatTask,
                integerTask,
                booleanTask);

            sensors =
                sensorTask.Result
                ?? new List<SensorRegistration>();

            sensors =
                sensors
                    .OrderBy(sensor =>
                        sensor.DeviceIdentifier)
                    .ToList();

            List<TelemetryPacket<float>> floatPackets =
                floatTask.Result
                ?? new List<TelemetryPacket<float>>();

            List<TelemetryPacket<int>> integerPackets =
                integerTask.Result
                ?? new List<TelemetryPacket<int>>();

            List<TelemetryPacket<bool>> booleanPackets =
                booleanTask.Result
                ?? new List<TelemetryPacket<bool>>();

            floatCount = floatPackets.Count;
            integerCount = integerPackets.Count;
            booleanCount = booleanPackets.Count;

            allTelemetry =
                new List<TelemetryDisplayRow>();

            allTelemetry.AddRange(
                floatPackets.Select(packet =>
                    new TelemetryDisplayRow
                    {
                        SensorId =
                            packet.SensorId,

                        DeviceIdentifier =
                            packet.DeviceIdentifier,

                        TelemetryType =
                            "Environmental",

                        MetricName =
                            packet.MetricName,

                        DisplayValue =
                            $"{packet.Value:F2} {packet.Unit}",

                        TimestampUtc =
                            packet.TimestampUtc
                    }));

            allTelemetry.AddRange(
                integerPackets.Select(packet =>
                    new TelemetryDisplayRow
                    {
                        SensorId =
                            packet.SensorId,

                        DeviceIdentifier =
                            packet.DeviceIdentifier,

                        TelemetryType =
                            "Power",

                        MetricName =
                            packet.MetricName,

                        DisplayValue =
                            $"{packet.Value:N0} {packet.Unit}",

                        TimestampUtc =
                            packet.TimestampUtc
                    }));

            allTelemetry.AddRange(
                booleanPackets.Select(packet =>
                    new TelemetryDisplayRow
                    {
                        SensorId =
                            packet.SensorId,

                        DeviceIdentifier =
                            packet.DeviceIdentifier,

                        TelemetryType =
                            "Actuator",

                        MetricName =
                            packet.MetricName,

                        DisplayValue =
                            FormatBooleanValue(
                                packet.MetricName,
                                packet.Value),

                        TimestampUtc =
                            packet.TimestampUtc
                    }));

            allTelemetry =
                allTelemetry
                    .OrderByDescending(
                        packet => packet.TimestampUtc)
                    .ToList();

            metricNames =
                allTelemetry
                    .Select(packet =>
                        packet.MetricName)
                    .Distinct()
                    .OrderBy(metric =>
                        metric)
                    .ToList();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to retrieve telemetry: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private IEnumerable<SensorRegistration>
        EligibleSubmissionSensors
    {
        get
        {
            IEnumerable<SensorRegistration> filteredSensors =
                submissionType switch
                {
                    "Integer" =>
                        sensors.Where(sensor =>
                            sensor.Category ==
                            SensorCategory.PowerConsumption),

                    "Boolean" =>
                        sensors.Where(sensor =>
                            sensor.Category ==
                            SensorCategory.Actuator),

                    _ =>
                        sensors.Where(sensor =>
                            sensor.Category ==
                            SensorCategory.Environmental)
                };

            return filteredSensors
                .OrderBy(sensor =>
                    sensor.DeviceIdentifier);
        }
    }

    private List<string> AvailableSubmissionMetrics
    {
        get
        {
            return submissionType switch
            {
                "Integer" =>
                    new List<string>
                    {
                        "Power Draw",
                        "Energy Usage",
                        "Flow Rate"
                    },

                "Boolean" =>
                    new List<string>
                    {
                        "Valve State",
                        "Pump State",
                        "Relay State"
                    },

                _ =>
                    new List<string>
                    {
                        "Soil Moisture",
                        "Temperature",
                        "Humidity"
                    }
            };
        }
    }

    private void SubmissionTypeChanged(
        ChangeEventArgs args)
    {
        submissionType =
            args.Value?.ToString()
            ?? "Float";

        submissionSensorId =
            string.Empty;

        submissionNumericValue =
            null;

        submissionBooleanValue =
            "true";

        submissionSuccess =
            null;

        submissionError =
            null;

        if (submissionType == "Integer")
        {
            submissionMetric =
                "Power Draw";

            submissionUnit =
                "W";
        }
        else if (submissionType == "Boolean")
        {
            submissionMetric =
                "Valve State";

            submissionUnit =
                "State";
        }
        else
        {
            submissionMetric =
                "Soil Moisture";

            submissionUnit =
                "%";
        }
    }

    private void SubmissionMetricChanged(
        ChangeEventArgs args)
    {
        submissionMetric =
            args.Value?.ToString()
            ?? string.Empty;

        submissionUnit =
            submissionMetric switch
            {
                "Soil Moisture" => "%",
                "Temperature" => "°C",
                "Humidity" => "%",

                "Power Draw" => "W",
                "Energy Usage" => "Wh",
                "Flow Rate" => "L/h",

                "Valve State" => "State",
                "Pump State" => "State",
                "Relay State" => "State",

                _ => string.Empty
            };

        submissionSuccess =
            null;

        submissionError =
            null;
    }

    private async Task SubmitTelemetry()
    {
        submissionSuccess = null;
        submissionError = null;

        if (!Guid.TryParse(
            submissionSensorId,
            out Guid sensorId))
        {
            submissionError =
                "Please select a registered sensor.";

            return;
        }

        SensorRegistration? sensor =
            sensors.FirstOrDefault(
                item => item.Id == sensorId);

        if (sensor is null)
        {
            submissionError =
                "The selected sensor could not be found.";

            return;
        }

        if (string.IsNullOrWhiteSpace(
            submissionMetric))
        {
            submissionError =
                "Please select a telemetry metric.";

            return;
        }

        if (string.IsNullOrWhiteSpace(
            submissionUnit))
        {
            submissionError =
                "Please provide the telemetry unit.";

            return;
        }

        submittingReading = true;

        try
        {
            HttpResponseMessage response;

            if (submissionType == "Float")
            {
                if (!submissionNumericValue.HasValue)
                {
                    submissionError =
                        "Please enter a numeric telemetry value.";

                    return;
                }

                TelemetryPacket<float> packet =
                    new(
                        sensor.Id,
                        sensor.DeviceIdentifier,
                        submissionMetric,
                        submissionUnit,
                        (float)submissionNumericValue.Value);

                response =
                    await Http.PostAsJsonAsync(
                        "api/telemetry/float",
                        packet);
            }
            else if (submissionType == "Integer")
            {
                if (!submissionNumericValue.HasValue)
                {
                    submissionError =
                        "Please enter a numeric telemetry value.";

                    return;
                }

                double suppliedValue =
                    submissionNumericValue.Value;

                if (suppliedValue !=
                    Math.Truncate(suppliedValue))
                {
                    submissionError =
                        "Integer telemetry requires a whole-number value.";

                    return;
                }

                if (suppliedValue < int.MinValue ||
                    suppliedValue > int.MaxValue)
                {
                    submissionError =
                        "The supplied integer value is outside the supported range.";

                    return;
                }

                TelemetryPacket<int> packet =
                    new(
                        sensor.Id,
                        sensor.DeviceIdentifier,
                        submissionMetric,
                        submissionUnit,
                        (int)suppliedValue);

                response =
                    await Http.PostAsJsonAsync(
                        "api/telemetry/integer",
                        packet);
            }
            else
            {
                bool booleanValue =
                    submissionBooleanValue == "true";

                TelemetryPacket<bool> packet =
                    new(
                        sensor.Id,
                        sensor.DeviceIdentifier,
                        submissionMetric,
                        submissionUnit,
                        booleanValue);

                response =
                    await Http.PostAsJsonAsync(
                        "api/telemetry/boolean",
                        packet);
            }

            if (response.IsSuccessStatusCode)
            {
                submissionSuccess =
                    $"{sensor.DeviceIdentifier} — {submissionMetric} " +
                    "was accepted by the Smart-X gateway.";

                submissionNumericValue =
                    null;

                await LoadTelemetry(
                    showLoadingPanel: false);
            }
            else
            {
                string responseBody =
                    await response.Content
                        .ReadAsStringAsync();

                submissionError =
                    $"Gateway rejected the telemetry packet " +
                    $"(HTTP {(int)response.StatusCode}). " +
                    responseBody;
            }
        }
        catch (Exception ex)
        {
            submissionError =
                $"Telemetry submission failed: {ex.Message}";
        }
        finally
        {
            submittingReading = false;
        }
    }

    private IEnumerable<TelemetryDisplayRow>
        FilteredTelemetry
    {
        get
        {
            IEnumerable<TelemetryDisplayRow> query =
                allTelemetry;

            if (!string.Equals(
                selectedType,
                "All",
                StringComparison.OrdinalIgnoreCase))
            {
                query =
                    query.Where(row =>
                        row.TelemetryType.Equals(
                            selectedType,
                            StringComparison.OrdinalIgnoreCase));
            }

            if (!string.Equals(
                selectedMetric,
                "All",
                StringComparison.OrdinalIgnoreCase))
            {
                query =
                    query.Where(row =>
                        row.MetricName.Equals(
                            selectedMetric,
                            StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(
                searchText))
            {
                query =
                    query.Where(row =>
                        row.DeviceIdentifier.Contains(
                            searchText,
                            StringComparison.OrdinalIgnoreCase)
                        ||
                        row.MetricName.Contains(
                            searchText,
                            StringComparison.OrdinalIgnoreCase));
            }

            return query;
        }
    }

    private void ClearFilters()
    {
        searchText =
            string.Empty;

        selectedType =
            "All";

        selectedMetric =
            "All";
    }

    private static string FormatBooleanValue(
        string metricName,
        bool value)
    {
        return metricName switch
        {
            "Valve State" =>
                value ? "Open" : "Closed",

            "Pump State" =>
                value ? "Running" : "Stopped",

            "Relay State" =>
                value ? "Enabled" : "Disabled",

            _ =>
                value ? "True" : "False"
        };
    }

    private static string GetTypeClass(
        string telemetryType)
    {
        return telemetryType switch
        {
            "Environmental" => "environmental",
            "Power" => "power",
            "Actuator" => "actuator",
            _ => string.Empty
        };
    }

    private static string GetTypeLetter(
        string telemetryType)
    {
        return telemetryType switch
        {
            "Environmental" => "E",
            "Power" => "P",
            "Actuator" => "A",
            _ => "T"
        };
    }

    private sealed class TelemetryDisplayRow
    {
        public Guid SensorId { get; set; }

        public string DeviceIdentifier { get; set; } =
            string.Empty;

        public string TelemetryType { get; set; } =
            string.Empty;

        public string MetricName { get; set; } =
            string.Empty;

        public string DisplayValue { get; set; } =
            string.Empty;

        public DateTime TimestampUtc { get; set; }
    }
}
