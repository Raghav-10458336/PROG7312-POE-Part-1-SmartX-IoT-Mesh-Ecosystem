@page "/history"
@using System.Net.Http.Json
@using System.Text.Json
@using System.Globalization
@inject HttpClient Http
@using Microsoft.AspNetCore.Components

<PageTitle>Smart-X | Historical Telemetry</PageTitle>

<div class="dashboard-page">
    <aside class="sidebar">
        <a class="sidebar-brand" href="/">
            <div class="brand-mark">SX</div>
            <div>
                <strong>Smart-X</strong>
                <span>IoT Mesh</span>
            </div>
        </a>

        <nav class="sidebar-nav">
            <span class="nav-label">TELEMETRY WORKSPACE</span>

            <a class="nav-item" href="/dashboard">
                <span class="nav-icon">⌂</span>
                Dashboard
            </a>

            <a class="nav-item" href="/sensors">
                <span class="nav-icon">◉</span>
                Sensors
            </a>

            <a class="nav-item" href="/telemetry">
                <span class="nav-icon">⌁</span>
                Telemetry
            </a>

            <a class="nav-item" href="/alerts">
                <span class="nav-icon">!</span>
                Attention Centre
            </a>

            <span class="nav-label secondary-label">MANAGEMENT</span>

            <a class="nav-item" href="/attachments">
                <span class="nav-icon">□</span>
                Attachments
            </a>

            <a class="nav-item" href="/deployment">
                <span class="nav-icon">⌘</span>
                Deployment Validation
            </a>

            <span class="nav-label secondary-label">COMMAND MANAGEMENT</span>

            <a class="nav-item" href="/commands">
                <span class="nav-icon">⇄</span>
                Command Stream &amp; History
            </a>

            <a class="nav-item active" href="/history">
                <span class="nav-icon">◷</span>
                Historical Telemetry
            </a>
        </nav>

        <div class="sidebar-footer">
            <span class="sidebar-status">
                <span class="status-dot"></span>
                Smart-X Gateway
            </span>
            <span>Smart-X Part 2</span>
        </div>
    </aside>

    <div class="dashboard-main">
        <header class="dashboard-header">
            <div>
                <span class="page-eyebrow">
                    SMART-X / MODULE 02
                </span>

                <h1>Historical Telemetry</h1>

                <p>
                    Explore recorded gateway readings by date,
                    device and measurement type.
                </p>
            </div>

            <div class="header-actions">
                <a class="secondary-button" href="/commands">
                    ← Back to Command Stream
                </a>

                <button class="primary-button"
                        disabled="@loading"
                        @onclick="ApplyFilters">
                    Refresh history
                </button>
            </div>
        </header>

        <section class="panel history-panel">
            <div class="panel-heading">
                <div>
                    <span class="panel-eyebrow">
                        HISTORICAL DATA
                    </span>
                    <h2>Telemetry timeline</h2>
                </div>

                <span class="history-count">
                    @VisibleReadings.Count records displayed
                </span>
            </div>

            <div class="history-filter-grid">
                <div class="history-field">
                    <label for="history-start">
                        Start date and time (UTC)
                    </label>

                    <input id="history-start"
                           type="datetime-local"
                           class="history-input"
                           @bind="startUtc" />
                </div>

                <div class="history-field">
                    <label for="history-end">
                        End date and time (UTC)
                    </label>

                    <input id="history-end"
                           type="datetime-local"
                           class="history-input"
                           @bind="endUtc" />
                </div>

                <div class="history-field">
                    <label for="history-device">
                        Device identifier
                    </label>

                    <input id="history-device"
                           class="history-input"
                           placeholder="e.g. ESP32-ACT-02"
                           @bind="deviceFilter"
                           @bind:event="oninput" />

                    <small>
                        Optional: enter a full or partial device identifier.
                    </small>
                </div>

                <div class="history-field">
                    <label for="history-metric">
                        Measurement / metric
                    </label>

                    <select id="history-metric"
                            class="history-input"
                            @bind="metricFilter">
                        <option value="All">All measurements</option>

                        @foreach (string metric in AvailableMetrics)
                        {
                            <option value="@metric">@metric</option>
                        }
                    </select>

                    <small>
                        Examples: Temperature, Soil Moisture,
                        Pump State, Relay State.
                    </small>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(focusedDevice))
            {
                <div class="history-focus" role="status">
                    Viewing suggested historical pattern for <strong>@focusedDevice</strong>.
                    <button type="button" class="history-secondary" @onclick="ResetFilters">Clear insight filter</button>
                </div>
            }

            <div class="history-toolbar">
                <button class="history-primary"
                        disabled="@loading"
                        @onclick="ApplyFilters">
                    @(loading ? "Loading..." : "Apply filters")
                </button>

                <button class="history-secondary"
                        disabled="@loading"
                        @onclick="ResetFilters">
                    Reset filters
                </button>

                <span class="history-help">
                    Showing the latest 50 matching records.
                </span>
            </div>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="history-error">
                    @errorMessage
                </div>
            }
            else if (loading)
            {
                <div class="history-empty">
                    Loading historical readings...
                </div>
            }
            else if (VisibleReadings.Count == 0)
            {
                <div class="history-empty">
                    No historical readings match these filters.
                    Try a wider UTC date range, another device,
                    or all measurements.
                </div>
            }
            else
            {
                <div class="history-table-wrap">
                    <table class="history-table">
                        <thead>
                            <tr>
                                <th>Recorded (local)</th>
                                <th>Device</th>
                                <th>Measurement</th>
                                <th>Value</th>
                                <th>Type</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (HistoryReading reading in VisibleReadings)
                            {
                                <tr @key="reading.Key">
                                    <td>
                                        @reading.TimestampUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss")
                                    </td>

                                    <td>
                                        <strong>@reading.DeviceIdentifier</strong>
                                    </td>

                                    <td>@reading.MetricName</td>

                                    <td>
                                        <span class="history-value">
                                            @reading.DisplayValue
                                        </span>
                                    </td>

                                    <td>
                                        <span class="history-type">
                                            @reading.DataType
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="history-footer">
                <span>
                    Date filters use UTC; displayed timestamps
                    are converted to your local time.
                </span>

                <a href="/commands">
                    Return to command operations →
                </a>
            </div>
        </section>
    </div>
</div>

<style>
    .history-focus {
        background: #eef8f9;
        border: 1px solid #c6e5e8;
        border-radius: 8px;
        padding: 12px 15px;
        margin-bottom: 16px;
        color: #246171;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
    }

    .history-panel {
        padding: 28px;
    }

    .history-count {
        color: #007f8e;
        font-size: 13px;
        font-weight: 700;
    }

    .history-filter-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
        margin: 28px 0 22px;
    }

    .history-field {
        display: flex;
        flex-direction: column;
        gap: 9px;
        min-width: 0;
    }

        .history-field label {
            color: #354b5f;
            font-size: 13px;
            font-weight: 700;
        }

        .history-field small {
            color: #8190a0;
            font-size: 12px;
            line-height: 1.5;
        }

    .history-input {
        width: 100%;
        min-width: 0;
        padding: 13px 14px;
        border: 1px solid #d6e0e7;
        border-radius: 8px;
        background: white;
        color: #203345;
        font: inherit;
        box-sizing: border-box;
    }

        .history-input:focus {
            outline: 2px solid #008899;
            outline-offset: 1px;
        }

    .history-toolbar {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 25px;
    }

    .history-primary,
    .history-secondary {
        border-radius: 8px;
        padding: 12px 18px;
        font: inherit;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
    }

    .history-primary {
        border: 1px solid #008392;
        background: #008392;
        color: white;
    }

    .history-secondary {
        border: 1px solid #d6e0e7;
        background: white;
        color: #40556b;
    }

        .history-primary:disabled,
        .history-secondary:disabled {
            opacity: .55;
            cursor: not-allowed;
        }

    .history-help {
        color: #8090a1;
        font-size: 12px;
    }

    .history-table-wrap {
        overflow-x: auto;
    }

    .history-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
        text-align: left;
    }

        .history-table th {
            color: #6b8093;
            font-size: 12px;
            font-weight: 700;
            padding: 15px 14px;
            border-bottom: 1px solid #dce5eb;
            white-space: nowrap;
        }

        .history-table td {
            padding: 16px 14px;
            border-bottom: 1px solid #edf1f4;
            color: #405569;
        }

        .history-table tbody tr:hover {
            background: #f6fafb;
        }

        .history-table td strong {
            color: #1d3040;
        }

    .history-value {
        color: #172d3d;
        font-weight: 700;
    }

    .history-type {
        display: inline-block;
        background: #edf4f6;
        color: #426579;
        padding: 5px 9px;
        border-radius: 6px;
        font-size: 12px;
    }

    .history-empty {
        text-align: center;
        color: #8494a4;
        padding: 65px 20px;
        font-size: 13px;
    }

    .history-error {
        background: #fff2f1;
        color: #b23434;
        border: 1px solid #f2cdca;
        border-radius: 8px;
        padding: 15px;
        margin: 20px 0;
    }

    .history-footer {
        display: flex;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
        padding-top: 24px;
        margin-top: 20px;
        border-top: 1px solid #e6ecf0;
        color: #8090a0;
        font-size: 12px;
    }

        .history-footer a {
            color: #008392;
            font-weight: 700;
            text-decoration: none;
        }

    @@media (max-width: 760px) {
        .history-filter-grid {
            grid-template-columns: 1fr;
        }

        .history-panel {
            padding: 18px;
        }
    }
</style>

@code {
    [SupplyParameterFromQuery(Name = "device")]
    public string? InsightDevice { get; set; }

    [SupplyParameterFromQuery(Name = "metric")]
    public string? InsightMetric { get; set; }

    [SupplyParameterFromQuery(Name = "days")]
    public int? InsightDays { get; set; }

    private string? focusedDevice;
    private bool loading;
    private string? errorMessage;

    private DateTime startUtc = DateTime.UtcNow.AddDays(-2);
    private DateTime endUtc = DateTime.UtcNow.AddDays(1);

    private string deviceFilter = "";
    private string metricFilter = "All";

    private List<HistoryReading> readings = new();

    private List<string> AvailableMetrics =>
        readings
            .Select(reading => reading.MetricName)
            .Concat(!string.IsNullOrWhiteSpace(InsightMetric) ? new[] { InsightMetric } : Array.Empty<string>())
            .Where(metric => !string.IsNullOrWhiteSpace(metric))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(metric => metric)
            .ToList();

    private List<HistoryReading> VisibleReadings =>
        readings
            .Where(reading =>
                (string.IsNullOrWhiteSpace(deviceFilter) ||
                 reading.DeviceIdentifier.Contains(
                     deviceFilter,
                     StringComparison.OrdinalIgnoreCase)) &&
                (metricFilter == "All" ||
                 reading.MetricName.Equals(
                     metricFilter,
                     StringComparison.OrdinalIgnoreCase)))
            .OrderByDescending(reading => reading.TimestampUtc)
            .Take(50)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(InsightDevice))
        {
            focusedDevice = InsightDevice.Trim();
            deviceFilter = focusedDevice;
            if (!string.IsNullOrWhiteSpace(InsightMetric))
                metricFilter = InsightMetric.Trim();
            if (InsightDays is > 0 and <= 30)
            {
                startUtc = DateTime.UtcNow.AddDays(-InsightDays.Value);
                endUtc = DateTime.UtcNow.AddMinutes(5);
            }
        }

        await ApplyFilters();
    }

    private async Task ApplyFilters()
    {
        if (loading)
            return;

        errorMessage = null;

        // datetime-local inputs have no timezone; treat their displayed values as UTC.
        if (startUtc == DateTime.MinValue || endUtc == DateTime.MinValue)
        {
            errorMessage = "Enter both UTC dates before applying filters.";
            return;
        }

        if (startUtc > endUtc)
        {
            errorMessage =
                "Start date cannot be after the end date.";
            return;
        }

        loading = true;

        try
        {
            // The backend provides date-range and device history endpoints.
            string start = Uri.EscapeDataString(
                DateTime.SpecifyKind(startUtc, DateTimeKind.Utc).ToString("yyyy-MM-ddTHH:mm:ssZ",
                    CultureInfo.InvariantCulture));

            string end = Uri.EscapeDataString(
                DateTime.SpecifyKind(endUtc, DateTimeKind.Utc).ToString("yyyy-MM-ddTHH:mm:ssZ",
                    CultureInfo.InvariantCulture));

            string endpoint =
                $"api/history/range?startUtc={start}&endUtc={end}";

            using HttpResponseMessage response =
                await Http.GetAsync(endpoint);

            response.EnsureSuccessStatusCode();

            using JsonDocument? document =
                await response.Content.ReadFromJsonAsync<JsonDocument>();

            List<HistoryReading> loaded = new();

            if (document is not null &&
                document.RootElement.ValueKind == JsonValueKind.Array)
            {
                int index = 0;

                foreach (JsonElement item in
                    document.RootElement.EnumerateArray())
                {
                    HistoryReading? reading =
                        ParseReading(item, index++);

                    if (reading is not null)
                        loaded.Add(reading);
                }
            }

            // Guard against inconsistent server ranges without changing the API contract.
            readings = loaded.Where(reading =>
                reading.TimestampUtc >= DateTime.SpecifyKind(startUtc, DateTimeKind.Utc) &&
                reading.TimestampUtc <= DateTime.SpecifyKind(endUtc, DateTimeKind.Utc)).ToList();

            // Keep a previously selected metric only if it still exists.
            if (metricFilter != "All" &&
                !AvailableMetrics.Contains(
                    metricFilter,
                    StringComparer.OrdinalIgnoreCase))
            {
                metricFilter = "All";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex is HttpRequestException
                ? "Unable to retrieve historical readings. Check the API connection and try again."
                : "Historical readings could not be loaded. Please try again.";
            readings.Clear();
        }
        finally
        {
            loading = false;
        }
    }

    private async Task ResetFilters()
    {
        focusedDevice = null;
        startUtc = DateTime.UtcNow.AddDays(-2);
        endUtc = DateTime.UtcNow.AddDays(1);
        deviceFilter = "";
        metricFilter = "All";

        await ApplyFilters();
    }

    private static HistoryReading? ParseReading(
        JsonElement item, int index)
    {
        if (item.ValueKind != JsonValueKind.Object)
            return null;

        string device = GetString(item, "deviceIdentifier");
        string metric = GetString(item, "metricName");
        string unit = GetString(item, "unit");

        if (string.IsNullOrWhiteSpace(device))
            return null;

        DateTime timestamp = DateTime.MinValue;

        if (item.TryGetProperty("timestampUtc", out var time) &&
            time.ValueKind == JsonValueKind.String)
        {
            DateTime.TryParse(
                time.GetString(),
                CultureInfo.InvariantCulture,
                DateTimeStyles.AssumeUniversal |
                DateTimeStyles.AdjustToUniversal,
                out timestamp);
        }

        string valueText = "—";
        string dataType = "Unknown";

        if (item.TryGetProperty("value", out var value))
        {
            switch (value.ValueKind)
            {
                case JsonValueKind.True:
                    valueText = "True";
                    dataType = "Boolean";
                    break;

                case JsonValueKind.False:
                    valueText = "False";
                    dataType = "Boolean";
                    break;

                case JsonValueKind.Number:
                    valueText = value.ToString();
                    dataType = "Numeric";
                    break;

                case JsonValueKind.String:
                    valueText = value.GetString() ?? "—";
                    dataType = "Text";
                    break;
            }
        }

        // Display actuator Boolean values as readable states.
        if (dataType == "Boolean")
        {
            bool isActive = valueText == "True";

            valueText = metric switch
            {
                "Pump State" => isActive ? "Running" : "Stopped",
                "Relay State" => isActive ? "Enabled" : "Disabled",
                "Valve State" => isActive ? "Open" : "Closed",
                _ => valueText
            };
        }
        else if (!string.IsNullOrWhiteSpace(unit))
        {
            valueText += $" {unit}";
        }

        return new HistoryReading
        {
            Key = $"{device}:{metric}:{timestamp.Ticks}:{index}",
            DeviceIdentifier = device,
            MetricName = metric,
            TimestampUtc = timestamp,
            DisplayValue = valueText,
            DataType = dataType
        };
    }

    private static string GetString(
        JsonElement item, string property)
    {
        return item.TryGetProperty(property, out var value)
            ? value.ToString()
            : "";
    }

    private sealed class HistoryReading
    {
        public string Key { get; set; } = "";
        public string DeviceIdentifier { get; set; } = "";
        public string MetricName { get; set; } = "";
        public DateTime TimestampUtc { get; set; }
        public string DisplayValue { get; set; } = "";
        public string DataType { get; set; } = "";
    }
}
